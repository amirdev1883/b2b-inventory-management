# Copy to .env.production and replace all placeholder values.
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-fifty-characters
DJANGO_ALLOWED_HOSTS=inventory.example.com
CSRF_TRUSTED_ORIGINS=https://inventory.example.com
FRONTEND_URL=https://inventory.example.com
# Percent-encode reserved characters in the database username/password.
DATABASE_URL=postgresql://user:password@managed-postgres:5432/b2b?sslmode=require
REDIS_URL=redis://redis:6379/0
# Enable only if your reverse proxy replaces client-supplied forwarding headers.
TRUST_PROXY_HEADERS=true
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=inventory@example.com
